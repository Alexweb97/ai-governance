# Généré automatiquement par install.sh (chmod 600). Ne jamais committer le .env réel.
PSEUDO_SECRET=remplacer-par-64-caracteres-hex-aleatoires
GRAFANA_ADMIN_PASSWORD=changez-moi
ADMIN_PASSWORD=changez-moi-aussi
HOST_UID=1000
HOST_GID=1000
GOV_LOG_DIR=/var/log/claude-governance
GOV_CONFIG_DIR=/home/<utilisateur>/.config/claude-governance
CLIENTS_DIR=/home/<utilisateur>/clients
